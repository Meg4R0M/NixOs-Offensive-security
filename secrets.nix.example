# Modèle de secrets. Copie ce fichier en `secrets.nix` (gitignoré) et remplis
# les hashes : `mkpasswd -m sha-512`  (ou `nix run nixpkgs#mkpasswd -- -m sha-512`).
{
  hashed = "$6$CHANGEME$............................................................";
  hashedRoot = "$6$CHANGEME$............................................................";
}
