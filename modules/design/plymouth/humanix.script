# ─────────────────────────────────────────────────────────────────────────────
# Humanix · Plymouth boot splash — phosphore vert (script module)
# Logo HUMANIX + sous-titre + barre de progression texte + ligne de statut.
# Note : couleurs en 0.0-1.0. Vert phosphore = (0.0, 1.0, 0.25).
# ─────────────────────────────────────────────────────────────────────────────

Window.SetBackgroundTopColor(0.02, 0.05, 0.02);
Window.SetBackgroundBottomColor(0.0, 0.02, 0.0);

sw = Window.GetWidth();
sh = Window.GetHeight();

# ── Logo ────────────────────────────────────────────────────────────────────
logo.image = Image.Text("H U M A N I X", 0.0, 1.0, 0.25, 1.0, "Sans Bold 44");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(sw / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(sh / 2 - logo.image.GetHeight() / 2 - 30);
logo.sprite.SetZ(10);

# ── Sous-titre ────────────────────────────────────────────────────────────────
sub.image = Image.Text("// MAKE HACKER COOL AGAIN", 0.1, 0.55, 0.15, 1.0, "Monospace 12");
sub.sprite = Sprite(sub.image);
sub.sprite.SetX(sw / 2 - sub.image.GetWidth() / 2);
sub.sprite.SetY(sh / 2 + 25);

# ── Barre de progression (texte, style terminal) ─────────────────────────────
prog.sprite = Sprite();
fun progress_cb(duration, progress) {
  cells = 34;
  filled = Math.Int(progress * cells);
  bar = "[";
  for (i = 0; i < cells; i++) {
    bar = bar + (i < filled ? "=" : "-");
  }
  bar = bar + "]";
  prog.image = Image.Text(bar, 0.0, 1.0, 0.25, 1.0, "Monospace 14");
  prog.sprite.SetImage(prog.image);
  prog.sprite.SetX(sw / 2 - prog.image.GetWidth() / 2);
  prog.sprite.SetY(sh / 2 + 60);
}
Plymouth.SetBootProgressFunction(progress_cb);

# ── Ligne de statut (messages services) — effet « log d'intrusion » ──────────
msg.sprite = Sprite();
fun message_cb(text) {
  msg.image = Image.Text("> " + text, 0.0, 0.9, 0.2, 1.0, "Monospace 11");
  msg.sprite.SetImage(msg.image);
  msg.sprite.SetX(sw / 2 - msg.image.GetWidth() / 2);
  msg.sprite.SetY(sh - 45);
}
Plymouth.SetDisplayMessageFunction(message_cb);

# ── Saisie mot de passe (déchiffrement LUKS au boot) ─────────────────────────
# CRITIQUE : sans ces callbacks, le prompt de passphrase ne s'affiche pas et le
# boot paraît figé (il faut presser ESC pour voir le prompt texte). On rend le
# prompt + les puces (astérisques) en vert phosphore, au centre.
prompt.sprite = Sprite();
bullets.sprite = Sprite();

fun display_password_cb(prompt_text, bullets_count) {
  prompt.image = Image.Text(prompt_text, 0.0, 1.0, 0.25, 1.0, "Monospace 14");
  prompt.sprite.SetImage(prompt.image);
  prompt.sprite.SetX(sw / 2 - prompt.image.GetWidth() / 2);
  prompt.sprite.SetY(sh / 2 + 100);
  prompt.sprite.SetOpacity(1);

  stars = "";
  for (i = 0; i < bullets_count; i++) {
    stars = stars + "*";
  }
  bullets.image = Image.Text("[ " + stars + " ]", 0.0, 1.0, 0.25, 1.0, "Monospace 18");
  bullets.sprite.SetImage(bullets.image);
  bullets.sprite.SetX(sw / 2 - bullets.image.GetWidth() / 2);
  bullets.sprite.SetY(sh / 2 + 132);
  bullets.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_normal_cb() {
  prompt.sprite.SetOpacity(0);
  bullets.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);
